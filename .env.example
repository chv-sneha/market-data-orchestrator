# =============================================================================
# Stock Market Data Pipeline - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your own values before running.
#
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Alpha Vantage API
# Get a free key at: https://www.alphavantage.co/support/#api-key
# -----------------------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=YOUR_API_KEY_HERE

# -----------------------------------------------------------------------------
# Stock symbols to track (comma-separated, no spaces)
# -----------------------------------------------------------------------------
STOCK_SYMBOLS=AAPL,MSFT,GOOGL

# -----------------------------------------------------------------------------
# PostgreSQL - application database
# (Must match the values used in the postgres service below)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stockdb
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=changeme_strong_password

# -----------------------------------------------------------------------------
# Airflow metadata database
# Airflow uses its own internal DB connection string.
# Keep AIRFLOW_DB_* in sync with the postgres service credentials.
# -----------------------------------------------------------------------------
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=changeme_airflow_password

# -----------------------------------------------------------------------------
# Airflow core settings
# Generate a new Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -----------------------------------------------------------------------------
AIRFLOW__CORE__FERNET_KEY=YOUR_FERNET_KEY_HERE
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__SECRET_KEY=YOUR_WEBSERVER_SECRET_HERE

# -----------------------------------------------------------------------------
# Airflow admin user (created during initialisation)
# -----------------------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
